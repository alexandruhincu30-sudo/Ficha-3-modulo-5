int EntreAB(int min, int max, int valor)
{
	if (valor >= min && valor <= max)
		return 1;
	else
	return 0;
}

int verif_string(char *texto)
{
    int quantidade = 0;

    for (int i = 0; texto[i] != '\0'; i++)
    {
        if (texto[i] >= '0' && texto[i] <= '9')
            quantidade++;
    }

    if (quantidade == 6)
        return 1;
    else
        return 0;
}

